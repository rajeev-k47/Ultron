DisplayType currentMode = STATIC;
byte (*selectedPattern)[7] = patterns[1];
Animation* selectedAnimation = &loading;

int currentFrame = 0;
unsigned long lastSwitch = 0;

Animation* animations[] = {
  &blinkFace,
  &loading
};


void setup() {
  Serial.begin(9600);
  for (int i=0;i<7;i++){ pinMode(colPins[i],OUTPUT); digitalWrite(colPins[i],LOW); }
  for (int i=0;i<8;i++){ pinMode(blueRows[i],OUTPUT); digitalWrite(blueRows[i],HIGH); }
  for (int i=0;i<8;i++){ pinMode(greenRows[i],OUTPUT); digitalWrite(greenRows[i],HIGH); }

}
int cmd =0 ;
void loop() {
  if (millis() - lastDhtRead >= 6000 && selectedPattern == twoDigit) {
    int chk = DHT.read11(DHT11_PIN);
    temperature = DHT.temperature;
    humidity = DHT.humidity;
    makeNumber(temperature);
    lastDhtRead = millis();
  }
    if (Serial.available()) {
    cmd = Serial.parseInt();
    switch (cmd) {
      case 1 ... 50:       
        selectedPattern = patterns[cmd];
        currentMode = STATIC;
        break;
      case 100 ... 110:
        selectedAnimation = animations[cmd-100];
        currentFrame = 0;
        lastSwitch = millis();
        currentMode = ANIMATION;
        break;
      case 111:
        selectedPattern = twoDigit;
        currentMode = STATIC;
        break;
    }
  }


  if (currentMode == STATIC) {
    showPattern(selectedPattern);
  } else if (currentMode == ANIMATION) {
    if (millis() - lastSwitch > selectedAnimation->delays[currentFrame]) {
      currentFrame = (currentFrame + 1) % selectedAnimation->frameCount ;
      lastSwitch = millis();
    }
    showPattern(selectedAnimation->frames[currentFrame]);
  }
}

void showPattern(byte pixels[7][7]) {
  for (int col = 0; col < 7; col++) {
    for (int c = 0; c < 7; c++) digitalWrite(colPins[c], LOW);
    digitalWrite(colPins[col], HIGH);

    for (int row = 0; row < 7; row++) {
      if (pixels[row][col] == 1) {
        digitalWrite(blueRows[row], LOW);
        digitalWrite(greenRows[row], LOW);

      }
      else{
       digitalWrite(blueRows[row], HIGH);
       digitalWrite(greenRows[row], HIGH);

       }
    }
    delayMicroseconds(400);
    for (int row = 0; row < 7; row++) {
      digitalWrite(blueRows[row], HIGH);
      digitalWrite(greenRows[row], HIGH);

      }
  }
}




