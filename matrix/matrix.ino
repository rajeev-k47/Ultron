byte twoDigit[7][7];

void makeNumber(int number) {
    for(int r=0;r<7;r++){
      for(int c=0;c<7;c++){
        twoDigit[r][c] = 0;
      }       
    }
    int tens = number / 10;
    int ones = number % 10;

    for(int r=0;r<5;r++)
      for(int c=0;c<3;c++)
        twoDigit[r+1][c] = DIGITS[tens][r][c];

    for(int r=0;r<5;r++)
      for(int c=0;c<3;c++)
        twoDigit[r+1][c+4] = DIGITS[ones][r][c];
}


